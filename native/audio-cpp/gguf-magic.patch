diff --git a/src/framework/assets/tensor_source.cpp b/src/framework/assets/tensor_source.cpp
index 9524e41..1a554b2 100644
--- a/src/framework/assets/tensor_source.cpp
+++ b/src/framework/assets/tensor_source.cpp
@@ -1716,6 +1716,13 @@ std::shared_ptr<const TensorSource> open_tensor_source(
             case TensorContainer::Gguf: return std::make_shared<GgufTensorSource>(path, options);
         }
     }
+    // Hugging Face snapshot symlinks resolve to extensionless content-addressed
+    // blobs. Identify standalone GGUF containers by their header in that case.
+    std::ifstream input(path, std::ios::binary);
+    char magic[4] = {};
+    if (input.read(magic, sizeof(magic)) && std::memcmp(magic, "GGUF", sizeof(magic)) == 0) {
+        return std::make_shared<GgufTensorSource>(path, options);
+    }
     throw std::runtime_error("unsupported tensor source format: " + path.string());
 }
 
